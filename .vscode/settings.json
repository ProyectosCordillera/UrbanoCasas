{
  // ESLint
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "html"
  ],
  "eslint.options": {
    "extensions": [".js", ".html"]
  },
  
  // HTMLHint
  "htmlhint.options": {
    "tagname-lowercase": true,
    "attr-lowercase": true,
    "attr-value-double-quotes": true
  },
  
  // Error Lens - Mostrar errores visiblemente
  "errorLens.enabled": true,
  "errorLens.errorBackground": "#ffcccc",
  "errorLens.errorForeground": "#ff0000",
  "errorLens.warningBackground": "#ffffcc",
  "errorLens.warningForeground": "#ffaa00",
  
  // Autoguardado
  "files.autoSave": "onFocusChange",
  
  // Validación HTML
  "html.validate.scripts": true,
  "html.validate.styles": true
}